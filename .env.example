# Copy this file to .env and fill in real values for your environment.
# .env is gitignored; never commit real secrets. See specs/001-multi-tenant-helpdesk/quickstart.md
# for how these are used in `docker compose up` and specs/001-multi-tenant-helpdesk/research.md
# (D24, D26) for the reasoning behind the layout.

# --- Tenancy / hosts (research D2) ---
# Base domain tenants are served from: {slug}.BASE_DOMAIN. In development this is "localhost",
# so browsers resolve acme.localhost etc. to 127.0.0.1 without editing the hosts file.
BASE_DOMAIN=localhost
# Host the platform-operator console is served from.
CONSOLE_HOST=console.localhost

# --- Database (research D3) ---
# Three roles, one database. See infra/postgres/init.sql (T013):
#   replyx_owner    owns the schema and runs migrations
#   replyx_app      tenant-scoped DML only, NOSUPERUSER, NOBYPASSRLS (subject to row-level security)
#   replyx_platform reads/writes only the global tables (tenants, platform_operators, ...)
# In docker compose the database host is the "postgres" service name.
DATABASE_URL_OWNER=postgres://replyx_owner:replyx_owner_dev_password@postgres:5432/replyx
DATABASE_URL_APP=postgres://replyx_app:replyx_app_dev_password@postgres:5432/replyx
DATABASE_URL_PLATFORM=postgres://replyx_platform:replyx_platform_dev_password@postgres:5432/replyx

# --- Cache / pub-sub ---
# In docker compose the Valkey (Redis-compatible) host is the "valkey" service name.
REDIS_URL=redis://valkey:6379

# --- Secrets (generate real random values for anything beyond local dev, e.g. `openssl rand -hex 32`) ---
SESSION_SECRET=dev-session-secret-change-me
# HMAC key used to sign time-limited file download tokens (research D17).
FILE_SIGNING_KEY=dev-file-signing-key-change-me
# AES-256-GCM key used to encrypt stored webhook secrets (research D16).
WEBHOOK_ENCRYPTION_KEY=dev-webhook-encryption-key-change-me

# --- File storage (research D17) ---
# "local" stores files on disk at FILES_DIR (a Docker volume in compose); "s3" uses the S3_*
# settings below. S3_* are only required when FILE_STORAGE=s3.
FILE_STORAGE=local
FILES_DIR=/data/files
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Outgoing email ---
# In docker compose this points at the "mailpit" service, which catches every outgoing email
# for local inspection at http://localhost:8025 instead of delivering it.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@replyx.test

# --- Malware scanning (research D26) ---
# clamd host:port for the "clamav" service (compose --profile scan). Leave empty in development
# to use the pass-through scanner, which marks every upload clean without scanning it; refused
# in production.
CLAMAV_HOST=

# --- Platform operator bootstrap (T075) ---
# Creates the first platform operator on startup if none exists yet.
OPERATOR_BOOTSTRAP_EMAIL=operator@replyx.test
OPERATOR_BOOTSTRAP_PASSWORD=operator-password

# --- Web push notifications (T243) ---
# Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Backups (production VM only, research D23/D24, infra/backup) ---
# Off-VM target for pgBackRest (PostgreSQL) and restic (uploaded files).
BACKUP_TARGET_TYPE=sftp
BACKUP_TARGET_HOST=
BACKUP_TARGET_PORT=22
BACKUP_TARGET_USER=
BACKUP_TARGET_PATH=
BACKUP_ENCRYPTION_KEY=

# --- Windows-only dev tuning (research D26) ---
# Set to true only if the repo is cloned on a Windows filesystem drive (not WSL2), so file
# watching (Nest restart, Vite HMR) falls back to polling instead of missing changes.
CHOKIDAR_USEPOLLING=false
