{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "dev:api": "nest start --watch --entryFile main.api",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "migrate": "tsx src/platform-kernel/db/migrator.ts",
    "seed:dev": "nest build && node dist/tenancy/dev-seed.js",
    "test": "vitest run",
    "test:cross-tenant": "vitest run test/cross-tenant",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.56.0",
    "file-type": "^21.0.0",
    "ioredis": "^5.6.0",
    "kysely": "^0.28.0",
    "luxon": "^3.7.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@testcontainers/postgresql": "^11.5.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "testcontainers": "^11.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^5.0.1"
  }
}
