# Production settings for the VM stack (infra/compose.prod.yml). Never commit real values.
#
# Do not copy this file by hand. `bash infra/scripts/init-env.sh` writes infra/.env.prod (mode
# 600) from it and replaces every __GENERATE_*__ marker with a random value; it refuses to
# overwrite an existing infra/.env.prod. deploy.sh refuses to run while a marker is left.
#
# Values are read by docker compose as plain KEY=VALUE lines: no quotes, no spaces around `=`.

# --- Hosts (tenants at {slug}.BASE_DOMAIN, operator console at CONSOLE_HOST) ---
BASE_DOMAIN=replyx.example.com
CONSOLE_HOST=console.replyx.example.com
# Loopback port on the VM where the caddy container listens; the host nginx proxies to it.
CADDY_PORT=8081
# Loopback port of the docs container; the host nginx proxies the apex host (BASE_DOMAIN) to it.
DOCS_PORT=8082

# --- Database roles (created on the FIRST start of an empty pgdata volume by infra/postgres/init.sql) ---
# Changing a password here later does NOT change it inside an existing database: rerun init.sql
# (see its header) or ALTER ROLE, then redeploy.
# Hex only, so the values are safe inside the connection URLs compose builds from them.
POSTGRES_PASSWORD=__GENERATE_HEX24__
REPLYX_OWNER_PASSWORD=__GENERATE_HEX24__
REPLYX_APP_PASSWORD=__GENERATE_HEX24__
REPLYX_PLATFORM_PASSWORD=__GENERATE_HEX24__
REPLYX_RETENTION_PASSWORD=__GENERATE_HEX24__

# --- Secrets ---
# Rotating SESSION_SECRET signs every user out; rotating FILE_SIGNING_KEY invalidates download
# links in flight.
SESSION_SECRET=__GENERATE_HEX32__
FILE_SIGNING_KEY=__GENERATE_HEX32__
# Seals tenant AI provider and store keys and webhook signing secrets. Must NEVER change once
# tenants have saved any.
REPLYX_SECRETS_KEY=__GENERATE_HEX32__

# --- AI Assist ---
AI_PROVIDER=openrouter
COMMERCE_PROVIDER=spree

# --- File storage ---
# "local" keeps uploads in the replyx-files volume (FILES_DIR=/data/files inside the containers).
# "s3" needs the S3_* values below.
FILE_STORAGE=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Malware scanning ---
# The api image runs with NODE_ENV=production, and the worker refuses to start without either a
# clamd address or an explicit opt-out. Pick one:
#   CLAMAV_HOST=clamav:3310  scan attachments; deploy.sh then starts the `clamav` service
#                            (compose profile `scan`, roughly 1.5-2 GB of RAM)
#   SCAN_DISABLED=true       no scanning: attachments are marked clean unscanned (logged at start)
# This host is short on RAM, so the default is the opt-out.
CLAMAV_HOST=
SCAN_DISABLED=true

# --- Logging ---
# pino level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Outgoing email (invitations, password resets, sign-in links). Replace with a real relay. ---
# Port 465 uses implicit TLS; other ports use STARTTLS when the server offers it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@replyx.example.com

# --- Platform operator bootstrap ---
# Creates the first platform operator (sign in at https://CONSOLE_HOST) on startup while none
# exists. After signing in and changing the password, blank both lines out.
OPERATOR_BOOTSTRAP_EMAIL=operator@replyx.example.com
OPERATOR_BOOTSTRAP_PASSWORD=__GENERATE_ALNUM24__

# --- Web push (optional; generate with `npx web-push generate-vapid-keys`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Backups (the `backup` service; on the VM only, off-VM copies are deferred) ---
# Nightly pg_dump at this UTC hour into the replyx-backups volume; the newest BACKUP_KEEP are kept.
BACKUP_HOUR_UTC=3
BACKUP_KEEP=14
